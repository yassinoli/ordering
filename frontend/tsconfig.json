{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022"
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true }
}
